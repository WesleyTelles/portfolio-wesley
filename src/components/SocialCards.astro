---
const socials = [
  { label: 'Wesley Telles no LinkedIn', href: 'https://linkedin.com/in/wesley-telles', highlight: '#0a66c2', icon: 'linkedin' },
  { label: 'Wesley Telles no GitHub', href: 'https://github.com/WesleyTelles', highlight: 'var(--ink)', icon: 'github' },
  { label: 'Enviar e-mail para Wesley Telles', href: 'mailto:wesleytellesbr@gmail.com', highlight: 'var(--signature)', icon: 'mail' },
];
---

<nav class="social-cards" aria-label="Links sociais">
  {socials.map((s) => (
    <a
      class="social-card"
      href={s.href}
      target={s.icon === 'mail' ? undefined : '_blank'}
      rel={s.icon === 'mail' ? undefined : 'noreferrer'}
      title={s.label}
      aria-label={s.label}
      style={`color: ${s.highlight}`}
    >
      <span class="social-card__glow" aria-hidden="true"></span>
      <span class="social-card__beam" aria-hidden="true"></span>
      <span class="social-card__icon">
        {s.icon === 'linkedin' && (
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5.1 3.5a2.1 2.1 0 1 0 0 4.2 2.1 2.1 0 0 0 0-4.2ZM3.3 8.9h3.6V20H3.3V8.9Zm5.8 0h3.4v1.5h.1c.5-.9 1.6-1.9 3.5-1.9 3.7 0 4.4 2.4 4.4 5.6V20h-3.6v-5.1c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V20H9.1V8.9Z"/></svg>
        )}
        {s.icon === 'github' && (
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.5v-1.9c-2.78.62-3.36-1.2-3.36-1.2-.46-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.74 0 0 .84-.28 2.75 1.05A9.36 9.36 0 0 1 12 6.84c.85 0 1.7.12 2.5.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.43.2 2.48.1 2.74.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.06.36.32.68.94.68 1.89v2.8c0 .28.18.6.69.5A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"/></svg>
        )}
        {s.icon === 'mail' && (
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        )}
      </span>
    </a>
  ))}
</nav>

<style>
  .social-cards {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .social-card {
    position: relative;
    isolation: isolate;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-raised);
    text-decoration: none;
    transition: border-color 260ms cubic-bezier(0.22, 1, 0.36, 1), background-color 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .social-card__glow {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(
      ellipse 78% 92% at 50% -4%,
      color-mix(in srgb, currentColor 38%, transparent) 0%,
      color-mix(in srgb, currentColor 16%, transparent) 38%,
      transparent 76%
    );
    opacity: 0.2;
  }

  .social-card__beam {
    position: absolute;
    top: 3px;
    right: 6px;
    left: 6px;
    height: 3px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.3;
    transform: scaleX(0.96);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1), opacity 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .social-card__icon {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    color: var(--ink-dim);
    opacity: 0.82;
    transform: scale(0.96);
    transition: color 420ms cubic-bezier(0.22, 1, 0.36, 1), opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .social-card__icon svg {
    width: 100%;
    height: 100%;
  }

  .social-card:hover,
  .social-card:focus-visible {
    border-color: color-mix(in srgb, currentColor 28%, var(--border));
    background: color-mix(in srgb, var(--bg-raised) 80%, currentColor 6%);
  }

  .social-card:hover .social-card__glow,
  .social-card:focus-visible .social-card__glow {
    opacity: 1;
  }

  .social-card:hover .social-card__beam,
  .social-card:focus-visible .social-card__beam {
    opacity: 1;
    transform: scaleX(1);
  }

  .social-card:hover .social-card__icon,
  .social-card:focus-visible .social-card__icon {
    color: inherit;
    opacity: 1;
    transform: scale(1);
  }

  .social-card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .social-card,
    .social-card__glow,
    .social-card__beam,
    .social-card__icon {
      transition-duration: 0.01ms;
    }
  }
</style>
