---
import { projects } from '../data/projects';
---

<section id="projects" class="projects">
  <div class="wrap">
    <p class="eyebrow">01 — Projetos</p>
    <h2 class="projects__title">O que já construí</h2>

    <div class="projects__list">
      {projects.map((p, i) => (
        <article class="project" id={p.slug} data-reveal>
          <div class="project__shot">
            {p.imageKind === 'concept' ? (
              <div class="cover-frame">
                <img src={p.image} alt={`Imagem conceitual do projeto ${p.name}`} loading="lazy" />
                <span class="cover-frame__tag">Imagem conceitual</span>
              </div>
            ) : (
              <div class="browser-frame">
                <div class="browser-frame__bar">
                  <span class="browser-frame__dot"></span>
                  <span class="browser-frame__dot"></span>
                  <span class="browser-frame__dot"></span>
                  <span class="browser-frame__url">{p.domain}</span>
                </div>
                <div class="browser-frame__viewport">
                  {p.image ? (
                    <img src={p.image} alt={`Tela do projeto ${p.name}`} loading="lazy" />
                  ) : (
                    <div class="browser-frame__placeholder">
                      <span class="browser-frame__placeholder-index">{String(i + 1).padStart(2, '0')}</span>
                      <span class="browser-frame__placeholder-label">screenshot a caminho</span>
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>

          <div class="project__body">
            <div class="project__index">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="project__name">{p.name}</h3>
            <div class="project__category-row">
              <p class="project__category">{p.category}</p>
              {p.partner === 'accenture' && (
                <span class="partner-badge" title="Em parceria com a Accenture">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#A100FF" d="M2 17.5 12 13v3.2L2 20.7v-3.2ZM12 13l10-4.5v3.2L12 16.2V13Z"/></svg>
                  Accenture
                </span>
              )}
            </div>
            <p class="project__context">{p.context}</p>

            <dl class="project__meta">
              <div>
                <dt>Meu papel</dt>
                <dd>{p.role}</dd>
              </div>
              <div>
                <dt>Decisão técnica</dt>
                <dd>{p.decision}</dd>
              </div>
            </dl>

            <ul class="project__stack">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>

            {p.links.length > 0 && (
              <div class="project__links">
                {p.links.map((l) => (
                  <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects__title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-block: 8px 48px;
  }

  .projects__list {
    display: flex;
    flex-direction: column;
  }

  .project {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding-block: 64px;
    border-top: 1px solid var(--border);
  }

  .project:last-child {
    border-bottom: 1px solid var(--border);
  }

  /* Ritmo editorial: alterna o lado da imagem a cada projeto. */
  .project:nth-child(even) .project__shot {
    order: 2;
  }

  /* Product shot */
  .browser-frame {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-raised);
  }

  .browser-frame__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
  }

  .browser-frame__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
  }

  .browser-frame__url {
    margin-left: 8px;
    font-size: 0.72rem;
    color: var(--ink-dim);
    font-family: var(--font-body);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser-frame__viewport {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .browser-frame__viewport {
    background: var(--bg);
  }

  .browser-frame__viewport img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    filter: grayscale(0.85) contrast(1.05);
    transform: scale(1.02);
    transition: filter 420ms cubic-bezier(0.22, 1, 0.36, 1), transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project:hover .browser-frame__viewport img {
    filter: grayscale(0);
    transform: scale(1.05);
  }

  .browser-frame__placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(160deg, var(--bg-raised), var(--bg));
  }

  .browser-frame__placeholder-index {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--border);
  }

  .browser-frame__placeholder-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
  }

  /* Cover — imagem conceitual, sem moldura de navegador para não sugerir que é UI real. */
  .cover-frame {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .cover-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.85) contrast(1.05);
    transform: scale(1.02);
    transition: filter 420ms cubic-bezier(0.22, 1, 0.36, 1), transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project:hover .cover-frame img {
    filter: grayscale(0);
    transform: scale(1.05);
  }

  .cover-frame__tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 5px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border: 1px solid var(--border);
    color: var(--ink-dim);
    backdrop-filter: blur(4px);
  }

  /* Body */
  .project__index {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--signature);
    margin-bottom: 8px;
  }

  .project__name {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
  }

  .project__category-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .project__category {
    color: var(--ink-dim);
    font-size: 0.85rem;
    margin: 0;
  }

  .partner-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.72rem;
    color: var(--ink-dim);
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .partner-badge svg {
    width: 12px;
    height: 12px;
  }

  .project__context {
    margin-top: 16px;
  }

  .project__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin: 24px 0 0;
  }

  .project__meta dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }

  .project__meta dd {
    margin: 6px 0 0;
    font-size: 0.92rem;
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
  }

  .project__stack li {
    font-size: 0.78rem;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink-dim);
  }

  .project__links {
    margin-top: 20px;
    display: flex;
    gap: 20px;
  }

  .project__links a {
    color: var(--signature);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 780px) {
    .project {
      grid-template-columns: 1fr;
    }

    .project:nth-child(even) .project__shot {
      order: 0;
    }

    .project__meta {
      grid-template-columns: 1fr;
    }
  }
</style>
