---
type IconName = 'case' | 'path' | 'stack' | 'contact' | 'arrow-up-right' | 'download' | 'scroll';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const icons: Record<IconName, string> = {
  case: '<path d="M4 8h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V8Z"/><path d="M9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M4 13h16"/>',
  path: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 7.4C10 10 9 13 12 14.5c2.5 1.2 3.8.6 5.6 2"/>',
  stack: '<path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Z"/><path d="m4 12 8 4.5 8-4.5"/><path d="m4 16.5 8 4.5 8-4.5"/>',
  contact: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M9 7h8v8"/>',
  download: '<path d="M12 4v11"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/>',
  scroll: '<rect x="8" y="3" width="8" height="14" rx="4"/><path d="M12 7v3"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
