---
---

<section id="top" class="hero">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero-enter" style="--d: 0ms">Software Developer</p>
      <h1 class="hero__title">
        <span class="hero-enter" style="--d: 80ms">Wesley</span><br />
        <span class="hero-enter" style="--d: 160ms">Telles<span class="hero__dot">.</span></span>
      </h1>
      <p class="hero__lede hero-enter" style="--d: 260ms">
        Construo interfaces e produtos reais — hoje em frontend na Red Media, evoluindo para fullstack.
        Projetos aplicados, não teoria de curso.
      </p>
      <div class="hero__cta hero-enter" style="--d: 340ms">
        <a class="btn btn--solid" href="#projects">Ver projetos</a>
        <a class="btn btn--ghost" href="#contact">Entrar em contato</a>
      </div>
    </div>

    <div class="hero__portrait hero-enter-portrait">
      <div class="hero__halo" aria-hidden="true"></div>
      <img
        class="hero__photo"
        src="/assets/images/wesley-portrait.png"
        alt="Retrato de Wesley Telles"
        width="768"
        height="1344"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(48px, 8vw, 96px);
    border-bottom: 1px solid var(--border);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 64px);
    align-items: center;
  }

  .hero__title {
    font-size: clamp(3.5rem, 9vw, 7rem);
    text-transform: uppercase;
    margin-block: 8px 24px;
  }

  .hero__dot {
    color: var(--signature);
  }

  .hero__lede {
    font-size: 1.05rem;
  }

  .hero__cta {
    display: flex;
    gap: 16px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 24px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid transparent;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .btn--solid {
    background: var(--signature);
    color: #0b0c0a;
  }

  .btn--solid:hover {
    transform: translateY(-2px);
  }

  .btn--ghost {
    border-color: var(--border);
    color: var(--ink);
  }

  .btn--ghost:hover {
    border-color: var(--signature);
    color: var(--signature);
  }

  .hero__portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    border-radius: 8px;
    background: var(--bg-raised);
  }

  .hero__halo {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 38%,
      color-mix(in srgb, var(--signature) 60%, transparent) 0%,
      color-mix(in srgb, var(--signature) 22%, transparent) 30%,
      transparent 60%
    );
  }

  .hero__photo {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__portrait {
      order: -1;
      aspect-ratio: 16 / 10;
    }
  }

  /* Entrada coreografada — um único momento, disparado uma vez ao carregar. */
  .hero__title span {
    display: inline-block;
  }

  .hero-enter {
    opacity: 0;
    transform: translateY(18px);
    animation: hero-enter 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  .hero-enter-portrait {
    opacity: 0;
    transform: scale(0.97);
    animation: hero-enter-portrait 900ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 120ms;
  }

  @keyframes hero-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-enter-portrait {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter,
    .hero-enter-portrait {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
